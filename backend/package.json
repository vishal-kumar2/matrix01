{
  "name": "ewaste-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
