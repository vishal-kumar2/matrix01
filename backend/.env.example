# ---------- Neon ----------
# Neon dashboard -> Connect -> toggle "Connection pooling" ON  -> copy -> DATABASE_URL (host has "-pooler")
# toggle OFF -> copy -> DIRECT_URL (used only by prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------- AWS (must match the bucket's region) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=                     # fill when Person C shares it

# ---------- Security / CORS ----------
WEBHOOK_SECRET=change-me-long-random-string
FRONTEND_ORIGIN=http://localhost:3000   # add Vercel URL later, comma separated, no trailing slash

# ---------- Optional ----------
PORT=4000
DENSITY_THRESHOLD=5
DISABLE_DUPLICATE_CHECK=false
# seed customisation
SEED_LAT=28.545
SEED_LNG=77.19
SEED_PIN=110016
SEED_HOSTEL=H1
